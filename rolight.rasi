/* Rolight – tema macOS, sincronizado con el rice: macos-dark */
/* Generado por build-rice.sh - NO editar a mano */
/* apply-rice-safe.sh copia este archivo a ~/.config/rolight/rolight.rasi */

configuration {
    show-icons:          true;
    icon-theme:          "WhiteSur-dark";
    matching:            "normal";
    tokenize:            true;
    sort:                false;
    drun-display-format: "{name}";
    kb-cancel:           "Escape,Super+d";
}

* {
    bg:        rgba(28, 28, 30, 88%);
    bg-input:  rgba(19, 19, 21, 80%);
    fg:        #f5f5f7;
    fg-dim:    #98989d;
    accent:    #0a84ff;
    sel:       rgba(10, 132, 255, 82%);
    line:      rgba(245, 245, 247, 12%);

    font:             "SF Pro Display 13";
    background-color: transparent;
    text-color:       @fg;
}

window {
    transparency:     "real";
    location:         north;
    anchor:           north;
    y-offset:         26%;
    width:            720px;
    border:           1px solid;
    border-color:     rgba(245, 245, 247, 16%);
    border-radius:    16px;
    background-color: @bg;
    padding:          0px;
}

mainbox {
    spacing:  0px;
    children: [ "inputbar", "message", "listview" ];
}

inputbar {
    padding:   16px 20px;
    spacing:   12px;
    border:    0px 0px 1px 0px;
    border-color: @line;
    children:  [ "prompt", "entry" ];
}

prompt {
    font:       "JetBrainsMono Nerd Font 18";
    text-color: @fg-dim;
    vertical-align: 0.5;
}

entry {
    font:              "SF Pro Display Light 20";
    placeholder:       "Buscar apps, archivos, web, IA, cuentas…";
    placeholder-color: rgba(245, 245, 247, 45%);
    cursor-color:      @accent;
    vertical-align:    0.5;
}

message {
    padding:      14px 22px;
    border:       0px 0px 1px 0px;
    border-color: @line;
}
textbox {
    markup:     true;
    text-color: @fg;
    font:       "SF Pro Display 13";
}

listview {
    lines:           8;
    columns:         1;
    fixed-height:    false;
    dynamic:         true;
    scrollbar:       false;
    padding:         8px;
    spacing:         2px;
}

element {
    padding:       8px 12px;
    spacing:       14px;
    border-radius: 9px;
    cursor:        pointer;
}
element normal.normal, element alternate.normal {
    background-color: transparent;
    text-color:       @fg;
}
element selected.normal {
    background-color: @sel;
    text-color:       #f5f5f7;
}
element-icon {
    size:           28px;
    vertical-align: 0.5;
    background-color: transparent;
    text-color:     inherit;
}
element-text {
    vertical-align:   0.5;
    background-color: transparent;
    text-color:       inherit;
    markup:           true;
}
